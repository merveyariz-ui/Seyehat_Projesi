const jwt = require('jsonwebtoken');
const JWT_SECRET = process.env.JWT_SECRET || 'merve_arel_sad_projesi_gizli_anahtari_2026';

module.exports = (req, res, next) => {
    try {
        // Gelen isteğin başlığındaki (Headers) Authorization kısmından token'ı çekiyoruz
        const authHeader = req.headers['authorization'];
        const token = authHeader && authHeader.split(' ')[1]; // "Bearer TOKEN_KODU" yapısını ayırır

        if (!token) {
            return res.status(401).json({ error: 'Erişim engellendi! Lütfen önce giriş yapın. 🔒' });
        }

        // Token geçerli mi, tahrif edilmiş mi kontrol et
        jwt.verify(token, JWT_SECRET, (err, decodedUser) => {
            if (err) {
                return res.status(403).json({ error: 'Geçersiz veya süresi dolmuş token! 🛑' });
            }

            // Token geçerliyse, içindeki kullanıcı ID'sini alıp istek nesnesine (req.user) gömüyoruz
            req.user = decodedUser;
            next(); // Güvenlik duvarından geçişe izin ver, sonraki fonksiyona ilerle
        });
    } catch (error) {
        res.status(500).json({ error: 'Kimlik doğrulama sırasında bir hata oluştu.' });
    }
};